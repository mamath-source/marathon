<script type="text/babel">
const {useState,useEffect}=React;
/* ================= CONFIG (tout ce qui change d'une course à l'autre) ================= */
const KEY="suivi-seville-v1",UNL="suivi-seville-unlocked-v1",DAY=864e5,ND=112;
const START=new Date(2026,10,2),RACE=new Date(2027,1,21); // lundi 2 nov 2026 → dimanche 21 fév 2027
const W0=67.5,STEP=.325,BASE=2016,SURP=150; // poids départ, perte/semaine de déficit, dépense estimée (1666+350), surplus toléré/jour si déficit 0
const CATS={ // 1 config globale par catégorie de semaine
 "Préparation":{def:2500,tol:.2,min:2,renfo:true,c:"#38bdf8"},
 "Entraînement":{def:2500,tol:.2,min:3,renfo:true,c:"#6366f1"},
 "Vacances":{def:0,tol:.2,min:3,renfo:true,c:"#10b981"},
 "Affûtage":{def:0,tol:.2,min:3,renfo:false,c:"#f59e0b"}};
const CAT_OF="P,P,E,E,E,E,E,V,V,E,E,E,E,E,A,A".split(",").map(x=>({P:"Préparation",E:"Entraînement",V:"Vacances",A:"Affûtage"}[x]));
const RUN=["EF","SL","VMA"],CODES=["EF","SL","VMA","RJ","RA","RB","RAB"],JOURS=["Lun","Mar","Mer","Jeu","Ven","Sam","Dim"];
const WEEKS=CAT_OF.map((cat,i)=>({i,cat,label:i<2?"P"+(i+1):"S"+(i-1),monday:new Date(2026,10,2+7*i)}));
{let a=0;WEEKS.forEach(w=>{w.target=Math.round((W0-a)*100)/100;if(CATS[w.cat].def>0)a+=STEP})}
const TBD="À définir";
const REWARDS=[ // PLACEHOLDERS : à remplacer par tes règles
 ...[66.5,66,65.5,65,64.5,64].map((t,k)=>({id:"w"+k,cat:"⚖️ Poids",name:"Sous "+t+" kg",cond:"Sous "+t+" kg",reward:TBD,type:"weight",t})),
 {id:"gap",cat:"⚖️ Poids",name:"Volonté de fer",cond:"Vacances : écart S5-S8 ≤ 1 kg",reward:TBD,type:"gap",a:6,b:9,max:1},
 {id:"b1",cat:"🏃 Blocs sport",name:"Bloc S1-S4",cond:"≥3 semaines sport validées & ≥9 sorties",reward:TBD,type:"block",from:2,to:5,w:3,n:9},
 {id:"b2",cat:"🏃 Blocs sport",name:"Bloc S5-S8",cond:"≥3 semaines sport validées & ≥9 sorties",reward:TBD,type:"block",from:6,to:9,w:3,n:9},
 {id:"b3",cat:"🏃 Blocs sport",name:"Bloc S9-S12",cond:"≥3 semaines sport validées & ≥9 sorties",reward:TBD,type:"block",from:10,to:13,w:3,n:9},
 {id:"b4",cat:"🏃 Blocs sport",name:"Bloc S13-S14",cond:"2 semaines sport validées & ≥6 sorties",reward:TBD,type:"block",from:14,to:15,w:2,n:6},
 {id:"sl1",cat:"🎽 Sorties longues",name:"C'est long…",cond:"8 SL réalisées",reward:TBD,type:"sl",t:8},
 {id:"sl2",cat:"🎽 Sorties longues",name:"C'est très long…",cond:"12 SL réalisées",reward:TBD,type:"sl",t:12},
 ...[6,10,14].map(t=>({id:"p"+t,cat:"🔥 Semaines parfaites",name:t+" semaines parfaites",cond:t+" semaines parfaites",reward:TBD,type:"perfect",t})),
 {id:"fin",cat:"🏁 Marathon",name:"Finisher",cond:"Marathon terminé",reward:TBD,type:"fin"},
 {id:"time",cat:"🏁 Marathon",name:"Objectif temps",cond:"Sous 3h50",reward:TBD,type:"time",t:3*3600+50*60},
 {id:"body",cat:"⚖️ Poids",name:"Athlète 2.0",cond:"Gras < 27 % et muscle > 31 %",reward:TBD,type:"body"},
 {id:"plan",cat:"🏁 Marathon",name:"Trust the plan",cond:"55 séances du plan cochées",reward:TBD,type:"plan",t:55}];
// Coffre secret : laisser vide ; à remplir par quelqu'un d'autre (reward + règle unlock(ctx))
const SECRET={reward:"",unlock:x=>false};
const PLAN=[ // W1..W14 (identifiés S1..S14) ; "~" sépare les cases, "|" titre/détail
`EF|45'~VMA 100|2x (8x30"30") - R3'~EF|50'~SL - 1h10|EF 75%`,`PPG|20 min + 2x6' PPG~EF|45'~VMA 105|2x (8x200m-30") - R3'~SL - 1h20|2x8' AS21`,
`EF|45' à 1h~VMA 100|12x 300m - 50"~EF|50'~SL - 1h30|2x12' AS42`,`PPG|30 min + 2x8' PPG~EF|50'~VMA 95|2x (5x 400m - 1') - R3'~SL - 1h30|3x8' AS21`,
`EF|45'~VMA 100|2x (8x30"30") - R3'~EF|1h~/`,`EF|45'~VMA 100|2x (6x 300m - 45") - R3'~EF|45'~SL - 1h43|2x 3km AS42`,
`EF|45' à 1h~VMA 95|2x (5x 500m - 1') - R3'~EF|1h~SL - 1h40|3x 3km AS42`,`EF|45' à 1h~AS21|10' + 8' + 6' AS21 - R2'~EF|1h~SL - 1h40|2x (4km + 3km) AS42`,
`EF|45' à 1h~VMA 105|2x(10x200m-30") - R2'~EF|1h~SL - 1h50|3x4km AS42`,`EF|1h~EF|50'~EF|40'~SL - AS42|Semi à AS42`,
`EF|45'~VMA 105|2x (12x30"30") - R3'~EF|45' à 1h~SL - 2h15|5km + 4km + 3km AS42`,`EF|45'~AS42|30' EF + 20' AS42~EF|1h~SL - 1h50|2x5km AS42`,
`EF|45' à 1h~AS42|20' EF + 40' AS42~EF|1h~SL - 1h20|2x20' AS42`,`EF|1h~EF|50'~EF|40'~MARATHON`
].map(s=>s.split("~").map(c=>{const[t,d]=c.split("|");return{t,d:d||"",e:t==="/"}}));
/* ================= LOGIQUE ================= */
const E7=f=>Array.from({length:7},f),fmt=d=>d.toLocaleDateString("fr-FR",{day:"numeric",month:"short"});
const norm=r=>{r=r||{};return{poids:r.poids||"",plan:E7((_,i)=>r.plan?.[i]||[]),jours:E7((_,i)=>({done:r.jours?.[i]?.done||[],garmin:r.jours?.[i]?.garmin||"",kcal:r.jours?.[i]?.kcal||""}))}};
const hasData=r=>{if(!r)return false;const w=norm(r);return !!w.poids||w.plan.some(p=>p.length)||w.jours.some(j=>j.done.length||j.garmin||j.kcal)};
const hasRenfo=d=>d.includes("RJ")||d.includes("RAB")||(d.includes("RA")&&d.includes("RB"));
const num=v=>parseFloat(v)>0?parseFloat(v):null;
function pos(){const d=Math.floor((new Date()-START)/DAY);if(d<0)return{w:0,d:0};return{w:Math.min(Math.floor(d/7),15),d:Math.min(d,111)%7}}
function kpi(i,data){
 const W=WEEKS[i],C=CATS[W.cat],w=norm(data[i]),p=pos(),dd=C.def/7;
 const poids=parseFloat(w.poids)||null,poidsOk=poids!==null&&poids<=W.target+C.tol;
 const done=w.jours.flatMap(j=>j.done),runs=done.filter(s=>RUN.includes(s)).length;
 const courseOk=runs>=C.min,renfoOk=hasRenfo(done);
 const sportOk=done.length?courseOk&&(!C.renfo||renfoOk):null;
 const full=w.jours.map(j=>num(j.kcal)&&num(j.garmin)?num(j.garmin)-num(j.kcal):null);
 // cumul proportionnel : semaine passée = 7/7, semaine en cours = jours écoulés/7, future = rien
 let frac=0;if(i<p.w)frac=7;else if(i===p.w)frac=p.d+(full[p.d]!==null?1:0);
 const reel=Math.round(full.slice(0,frac).reduce((a,b)=>a+(b||0),0)),attendu=Math.round(C.def*frac/7);
 const any=full.some(x=>x!==null);
 const defStatus=!any||frac===0?null:C.def===0?reel>=-SURP*frac:reel<0?false:reel>=.9*attendu?true:"warn";
 const sportJour=w.jours.map((j,k)=>{const pr=w.plan[k];if(!pr.length&&!j.done.length)return null;if(!pr.length)return true;return pr.every(s=>j.done.includes(s))});
 const calJour=w.jours.map(j=>{const kc=num(j.kcal),g=num(j.garmin);if(!kc)return null;return g?g-kc>=(C.def>0?dd-50:-SURP):kc<=BASE-dd+80});
 const jourOk=sportJour.map((s,k)=>{const c=calJour[k];if(s===null&&c===null)return null;return s===false||c===false?false:true});
 return{poids,poidsOk,runs,courseOk,renfoOk,sportOk,perfect:sportOk===true&&poidsOk,reel,attendu,defStatus,sportJour,jourOk,nDone:done.length,nPlan:w.plan.flat().length};
}
const parseTime=v=>{if(!v)return null;const p=String(v).trim().split(":").map(x=>parseInt(x,10));if(p.some(isNaN))return null;return p.length===2?p[0]*3600+p[1]*60:p.length===3?p[0]*3600+p[1]*60+p[2]:null};
function status(r,x){
 const b=(v,t,d,m)=>({...r,unlocked:v>=t,progress:Math.min(1,v/t),detail:d,remaining:v>=t?"Débloquée":m});
 if(r.type==="weight"){const u=x.minW!==null&&x.minW<r.t;return{...r,unlocked:u,progress:x.minW===null?0:Math.max(0,Math.min(1,(W0-x.minW)/(W0-r.t))),detail:x.minW===null?"Poids non saisi":"Meilleur poids : "+x.minW.toFixed(1)+" kg",remaining:u?"Débloquée":"Encore à perdre"}}
 if(r.type==="gap"){const a=parseFloat(x.weeks[r.a].poids),c=parseFloat(x.weeks[r.b].poids),ok=!isNaN(a)&&!isNaN(c),g=ok?Math.abs(a-c):null,u=ok&&g<=r.max;return{...r,unlocked:u,progress:u?1:ok?Math.max(0,1-(g-r.max)/2):0,detail:ok?"Écart : "+g.toFixed(1)+" kg":"Poids requis",remaining:u?"Débloquée":"Écart à réduire"}}
 if(r.type==="block"){const idx=[...Array(r.to-r.from+1)].map((_,k)=>r.from+k),sw=idx.filter(k=>hasData(x.data[k])&&x.ks[k].sportOk===true).length,ru=idx.reduce((a,k)=>a+x.ks[k].runs,0),u=sw>=r.w&&ru>=r.n;return{...r,unlocked:u,progress:Math.min(1,sw/r.w,ru/r.n),detail:sw+"/"+r.w+" semaines · "+ru+"/"+r.n+" sorties",remaining:u?"Débloquée":"En cours"}}
 if(r.type==="sl")return b(x.sl,r.t,x.sl+"/"+r.t+" SL","Encore "+(r.t-x.sl)+" SL");
 if(r.type==="perfect")return b(x.perf,r.t,x.perf+"/"+r.t+" semaines parfaites","Encore "+(r.t-x.perf));
 if(r.type==="fin")return{...r,unlocked:!!x.mar.finished,progress:x.mar.finished?1:0,detail:"À valider après la course",remaining:"Cocher Finisher"};
 if(r.type==="time"){const s=parseTime(x.mar.time),u=s!==null&&s<r.t;return{...r,unlocked:u,progress:u?1:0,detail:x.mar.time?"Temps : "+x.mar.time:"Temps à saisir",remaining:"Saisir un temps"}}
 if(r.type==="body"){const f=!!x.body.fat,m=!!x.body.muscle;return{...r,unlocked:f&&m,progress:((f?1:0)+(m?1:0))/2,detail:(f?"✓":"☐")+" Gras < 27 % · "+(m?"✓":"☐")+" Muscle > 31 %",remaining:"Cases à cocher"}}
 return b(x.plan,r.t,x.plan+"/"+r.t+" séances cochées","Encore "+(r.t-x.plan));
}
/* ================= UI ================= */
const card={background:"#1e293b",borderRadius:14,padding:14,border:"1px solid #334155"};
const inp={padding:"6px 8px",borderRadius:8,border:"1.5px solid #334155",background:"#0f172a",color:"#f8fafc",fontSize:13,textAlign:"center",width:90};
const stC=s=>s===true?{background:"#064e3b",color:"#6ee7b7"}:s==="warn"?{background:"#78350f",color:"#fbbf24"}:s===false?{background:"#450a0a",color:"#fca5a5"}:{background:"#1e293b",color:"#64748b"};
const Badge=({s,children})=><span style={{...stC(s),padding:"3px 10px",borderRadius:99,fontSize:12,fontWeight:600}}>{children}</span>;
const Bar=({v,c="#10b981"})=><div style={{height:6,background:"#0f172a",borderRadius:99,overflow:"hidden",marginTop:8}}><div style={{height:"100%",width:Math.round(v*100)+"%",background:c}}/></div>;
const lab={fontSize:11,color:"#64748b"};
function App(){
 const p0=pos();
 const [data,setData]=useState({}),[loaded,setLoaded]=useState(false),[tab,setTab]=useState("saisie"),[sem,setSem]=useState(p0.w),[jr,setJr]=useState(p0.d),[toast,setToast]=useState(null);
 useEffect(()=>{try{const s=localStorage.getItem(KEY);if(s)setData(JSON.parse(s))}catch(e){}setLoaded(true)},[]);
 const save=d=>{setData(d);try{localStorage.setItem(KEY,JSON.stringify(d))}catch(e){}};
 const upW=(i,f)=>save({...data,[i]:f(norm(data[i]))});
 const tog=(a,s)=>a.includes(s)?a.filter(x=>x!==s):[...a,s];
 const setJour=(f,v)=>upW(sem,w=>({...w,jours:w.jours.map((j,k)=>k===jr?{...j,[f]:v}:j)}));
 const setX=(k,f,v)=>save({...data,[k]:{...(data[k]||{}),[f]:v}});
 const mar=data._mar||{finished:false,time:""},body=data._body||{},chk=data._plan||{};
 const weeks=WEEKS.map((_,i)=>norm(data[i])),ks=WEEKS.map((_,i)=>kpi(i,data));
 const ws=weeks.map(w=>parseFloat(w.poids)).filter(v=>v>0);
 const ctx={data,weeks,ks,minW:ws.length?Math.min(...ws):null,sl:weeks.reduce((a,w)=>a+w.jours.reduce((b,j)=>b+j.done.filter(s=>s==="SL").length,0),0),perf:ks.filter(k=>k.perfect).length,mar,body:{fat:body.fat,muscle:body.muscle},plan:Object.values(chk).filter(Boolean).length};
 const rewards=REWARDS.map(r=>status(r,ctx));
 useEffect(()=>{if(!loaded)return;const ids=rewards.filter(r=>r.unlocked).map(r=>r.id);let prev=[];try{prev=JSON.parse(localStorage.getItem(UNL)||"[]")}catch(e){}const nu=ids.filter(i=>!prev.includes(i));if(nu.length){setToast(rewards.find(r=>r.id===nu[nu.length-1]));setTimeout(()=>setToast(null),4200)}try{localStorage.setItem(UNL,JSON.stringify([...new Set([...prev,...ids])]))}catch(e){}},[data,loaded]);
 if(!loaded)return <div style={{padding:40,textAlign:"center",color:"#94a3b8"}}>Chargement...</div>;
 const exp=async()=>{const t=JSON.stringify(data);try{await navigator.clipboard.writeText(t);alert("Copié !")}catch(e){prompt("Copie ce texte :",t)}};
 const imp=()=>{const t=prompt("Colle ta sauvegarde :");if(!t)return;try{save(JSON.parse(t))}catch(e){alert("Texte invalide")}};
 const resetW=()=>{if(!confirm("Effacer "+WEEKS[sem].label+" ?"))return;const d={...data};delete d[sem];save(d)};
 // progression automatique (dates)
 const elapsed=Math.max(0,Math.min(ND,(new Date()-START)/DAY)),prog=elapsed/ND,daysLeft=Math.max(0,Math.ceil((RACE-new Date())/DAY));
 const R=44,circ=2*Math.PI*R,col=prog<.33?"#6366f1":prog<.66?"#f59e0b":"#10b981";
 const W=WEEKS[sem],k=ks[sem],w=weeks[sem],j=w.jours[jr],C=CATS[W.cat],dd=Math.round(C.def/7);
 const unl=rewards.filter(r=>r.unlocked).length,secOpen=!!SECRET.reward&&SECRET.unlock(ctx);
 const road=Math.min(1,prog*.55+(unl/rewards.length)*.45);
 const defBadge=k.defStatus===null?"🍽️ Pas assez de données":"🍽️ Déficit : "+k.reel+" / "+k.attendu+" attendu";
 const wkBg=i=>{const q=ks[i];return sem===i?"#6366f1":!hasData(data[i])?"#1e293b":q.sportOk===false?"#450a0a":q.sportOk===true&&q.poidsOk===false?"#f59e0b":q.sportOk===true&&q.poidsOk&&q.defStatus!==true?"#166534":q.sportOk===true&&q.poidsOk&&q.defStatus===true?"#22c55e":"#1e293b"};
 const lastI=ws.length?weeks.map(x=>parseFloat(x.poids)>0).lastIndexOf(true):-1;
 const delta=lastI>=0?Math.round((parseFloat(weeks[lastI].poids)-WEEKS[lastI].target)*100)/100:null;
 const cats=rewards.reduce((a,r)=>{(a[r.cat]=a[r.cat]||[]).push(r);return a},{});
 const next=rewards.filter(r=>!r.unlocked).sort((a,b)=>b.progress-a.progress)[0];
 const tabs={saisie:"📝 Saisie",tableau:"📅 Tableau",graphiques:"📈 Graphiques",recompenses:"🏆 Récompenses",plan:"🏃 Plan Running"};
 const Pill=({on,c,onClick,children})=><button onClick={onClick} style={{padding:"5px 4px",borderRadius:99,width:"100%",border:"1.5px solid "+(on?c:"#1e293b"),background:on?c+"33":"#0f172a",color:on?c:"#334155",fontSize:11,fontWeight:700}}>{children}</button>;
 return <div style={{minHeight:"100vh"}}>
 <div style={{background:"linear-gradient(135deg,#1e293b,#0f172a)",padding:"20px 24px",borderBottom:"1px solid #1e293b"}}><div style={{maxWidth:900,margin:"0 auto",display:"flex",justifyContent:"space-between",flexWrap:"wrap",gap:12}}>
  <div><h1 style={{fontSize:22,color:"#f8fafc"}}>🏃 Mon suivi marathon</h1><p style={{fontSize:13,color:"#64748b",marginTop:4}}>Séville · 21 février 2027 · Objectif sous 64 kg</p></div>
  <div style={{display:"flex",gap:8,flexWrap:"wrap"}}>{Object.keys(tabs).map(t=><button key={t} onClick={()=>setTab(t)} style={{padding:"7px 14px",borderRadius:8,fontSize:13,border:"none",background:tab===t?"#6366f1":"#1e293b",color:tab===t?"#fff":"#94a3b8"}}>{tabs[t]}</button>)}
  <button onClick={exp} style={{padding:"7px 12px",borderRadius:8,fontSize:13,border:"1px solid #334155",background:"none",color:"#10b981"}}>💾 Sauver</button>
  <button onClick={imp} style={{padding:"7px 12px",borderRadius:8,fontSize:13,border:"1px solid #334155",background:"none",color:"#f59e0b"}}>📂 Charger</button></div></div></div>
 <div style={{maxWidth:900,margin:"0 auto",padding:"24px 16px"}}>
 {tab==="saisie"&&<div>
  <div style={{...card,display:"flex",alignItems:"center",gap:16,marginBottom:16}}>
   <svg width={104} height={104}><circle cx={52} cy={52} r={R} fill="none" stroke="#0f172a" strokeWidth={8}/><circle cx={52} cy={52} r={R} fill="none" stroke={col} strokeWidth={6} strokeLinecap="round" strokeDasharray={prog*circ+" "+circ} transform="rotate(-90 52 52)"/>
   <text x={52} y={46} textAnchor="middle" fill="#f8fafc" fontSize="16" fontWeight="bold">{Math.floor(elapsed)}</text><text x={52} y={62} textAnchor="middle" fill="#64748b" fontSize="11">/{ND}</text><text x={52} y={76} textAnchor="middle" fill={col} fontSize="10">{Math.round(prog*100)}%</text></svg>
   <div><div style={{fontSize:15,color:"#f8fafc",fontWeight:600}}>Progression</div><div style={{fontSize:13,color:"#94a3b8",marginTop:4}}>Jour {Math.floor(elapsed)} sur {ND}</div><div style={{fontSize:12,color:col,marginTop:4,fontWeight:600}}>{daysLeft} jour{daysLeft>1?"s":""} avant la course</div></div></div>
  <div style={{display:"flex",gap:6,flexWrap:"wrap",marginBottom:16}}>{WEEKS.map(x=><button key={x.i} onClick={()=>setSem(x.i)} style={{width:38,height:38,borderRadius:8,border:"none",fontSize:12,fontWeight:600,background:wkBg(x.i),color:"#e2e8f0"}}>{x.label}</button>)}</div>
  <div style={{...card,marginBottom:12}}><div style={{...lab,marginBottom:10,fontWeight:600}}>BILAN {W.label}</div><div style={{display:"flex",gap:10,flexWrap:"wrap"}}>
   <Badge s={k.poids?k.poidsOk:null}>{k.poids?"⚖️ "+k.poids+" kg (cible "+W.target+")":"⚖️ Poids non saisi"}</Badge><Badge s={k.defStatus}>{defBadge}</Badge><Badge s={k.sportOk}>🏃 {k.runs}/{C.min} sorties{C.renfo?" · renfo "+(k.renfoOk?"✓":"✗"):""}</Badge></div></div>
  <div style={{...card,display:"flex",gap:16,flexWrap:"wrap",alignItems:"center",marginBottom:12}}>
   <div><div style={lab}>Semaine {W.label} · {fmt(W.monday)}</div><div style={{fontSize:15,color:"#f8fafc",fontWeight:600,marginTop:4}}>Objectif {W.target} kg</div></div>
   <div style={{marginLeft:"auto",display:"flex",alignItems:"center",gap:10}}><span style={{fontSize:13,color:"#94a3b8"}}>⚖️ Poids lundi</span>
   <input type="number" step="0.1" value={w.poids} onChange={e=>upW(sem,x=>({...x,poids:e.target.value}))} placeholder="67.5" style={{...inp,width:80}}/><button onClick={resetW} style={{padding:"4px 10px",borderRadius:6,border:"1px solid #450a0a",background:"none",color:"#ef4444",fontSize:11}}>🗑 Réinit.</button></div></div>
  <div style={{display:"flex",gap:6,marginBottom:12}}>{JOURS.map((d,i)=>{const ok=k.jourOk[i];return <button key={i} onClick={()=>setJr(i)} style={{flex:1,padding:"8px 4px",borderRadius:8,border:"none",fontSize:12,fontWeight:600,background:jr===i?"#6366f1":ok===true?"#064e3b":ok===false?"#450a0a":"#1e293b",color:jr===i?"#fff":ok===true?"#6ee7b7":ok===false?"#fca5a5":"#64748b"}}>{d}<br/><span style={{fontSize:10}}>{ok===true?"🟢":ok===false?"🔴":"⚪"}</span></button>})}</div>
  <div style={{display:"grid",gap:12}}>
   <div style={card}><div style={{fontSize:13,color:"#94a3b8",fontWeight:600,marginBottom:8}}>🏃 Sport</div>
    <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:8}}><div style={{...lab,textAlign:"center",color:"#f59e0b"}}>Planifié</div><div style={{...lab,textAlign:"center",color:"#10b981"}}>Réalisé</div>
    {[...CODES,"AUTRE"].map(s=>[<Pill key={s+"p"} on={w.plan[jr].includes(s)} c="#f59e0b" onClick={()=>upW(sem,x=>({...x,plan:x.plan.map((a,q)=>q===jr?tog(a,s):a)}))}>{s}</Pill>,<Pill key={s+"d"} on={j.done.includes(s)} c="#10b981" onClick={()=>setJour("done",tog(j.done,s))}>{j.done.includes(s)?"✓ ":""}{s}</Pill>])}</div></div>
   <div style={card}><div style={{display:"flex",gap:8,flexWrap:"wrap",marginBottom:12}}><span style={{padding:"2px 8px",borderRadius:6,fontSize:11,background:"#f59e0b22",color:"#f59e0b"}}>🎯 Déficit visé : {dd} kcal</span>
    {num(j.kcal)&&num(j.garmin)&&<span style={{padding:"2px 8px",borderRadius:6,fontSize:11,fontWeight:700,...stC(num(j.garmin)-num(j.kcal)>=dd-50?true:num(j.garmin)-num(j.kcal)<0&&dd>0?false:"warn")}}>Déficit : {Math.round(num(j.garmin)-num(j.kcal))} kcal</span>}</div>
    <div style={{display:"flex",alignItems:"center",gap:12,marginBottom:12,flexWrap:"wrap"}}><span style={{fontSize:13,color:"#94a3b8"}}>🍴 Calories consommées</span><input type="number" value={j.kcal} onChange={e=>setJour("kcal",e.target.value)} placeholder="1660" style={inp}/><span style={lab}>kcal</span></div>
    <div style={{display:"flex",alignItems:"center",gap:12,paddingTop:10,borderTop:"1px solid #0f172a",flexWrap:"wrap"}}><span style={{fontSize:13,color:"#94a3b8"}}>⌚ Calories brûlées</span><input type="number" value={j.garmin} onChange={e=>setJour("garmin",e.target.value)} placeholder="2016" style={inp}/><span style={lab}>kcal</span></div></div></div></div>}
 {tab==="tableau"&&<div style={{overflowX:"auto"}}><table style={{width:"100%",borderCollapse:"collapse",fontSize:12}}><thead><tr>{["Semaine","Catégorie","⚖️ Réel","📉 Plan","🔮 Proj.","🔥 Cible","🍽️ Cumul","🏃 Sorties",...JOURS].map(h=><th key={h} style={{padding:"8px",color:"#64748b",borderBottom:"1px solid #1e293b",whiteSpace:"nowrap"}}>{h}</th>)}</tr></thead><tbody>
  {WEEKS.map(x=>{const q=ks[x.i],hd=hasData(data[x.i]),cc=CATS[x.cat],pr=delta!==null&&x.i>=lastI?Math.round((x.target+delta)*10)/10:null;return <tr key={x.i} onClick={()=>{setSem(x.i);setTab("saisie")}} style={{cursor:"pointer",background:sem===x.i?"#1e293b55":"none",borderBottom:"1px solid #0f172a",textAlign:"center"}}>
   <td style={{padding:"10px 8px",color:"#f8fafc",whiteSpace:"nowrap",textAlign:"left"}}>{x.label} · {fmt(x.monday)}</td>
   <td><span style={{padding:"2px 8px",borderRadius:99,fontSize:11,background:cc.c+"22",color:cc.c}}>{x.cat}</span></td>
   <td>{hd&&q.poids?<span style={{padding:"2px 8px",borderRadius:6,...stC(q.poidsOk)}}>{q.poids} kg</span>:"—"}</td><td style={{color:"#475569"}}>{x.target}</td>
   <td style={{color:delta>0.15?"#ef4444":"#6366f1",fontWeight:600}}>{pr===null?"—":pr+" kg"}</td><td style={{color:cc.def>0?"#f59e0b":"#334155"}}>{cc.def>0?cc.def:"—"}</td>
   <td>{hd&&q.defStatus!==null?<span style={{padding:"2px 8px",borderRadius:6,...stC(q.defStatus)}}>{q.reel}/{q.attendu}</span>:"—"}</td>
   <td>{hd?<span style={{padding:"2px 8px",borderRadius:6,...stC(q.sportOk)}}>{q.runs}/{cc.min}</span>:"—"}</td>
   {q.sportJour.map((o,i)=><td key={i} style={{padding:4}}><div style={{width:26,height:26,borderRadius:6,margin:"0 auto",lineHeight:"26px",...stC(o)}}>{o===true?"✓":o===false?"✗":""}</div></td>)}</tr>})}</tbody></table><div style={{marginTop:12,fontSize:12,color:"#64748b"}}>💡 Clique sur une ligne pour saisir la semaine.</div></div>}
 {tab==="graphiques"&&<div style={card}><div style={{fontSize:14,color:"#f8fafc",fontWeight:600,marginBottom:8}}>⚖️ Évolution du poids</div>
  {(()=>{const Wd=600,H=380,l=48,t=20,cW=Wd-l-20,cH=H-t-40,a=63,b=68,x=i=>l+i/15*cW,y=v=>t+cH-(v-a)/(b-a)*cH,pts=f=>WEEKS.map((q,i)=>{const v=f(q,i);return v>0?x(i)+","+y(v):null}).filter(Boolean).join(" ");
  return <svg viewBox={"0 0 "+Wd+" "+H} style={{width:"100%"}}>{[0,1,2,3,4,5].map(i=><g key={i}><line x1={l} x2={Wd-20} y1={y(a+i)} y2={y(a+i)} stroke="#334155"/><text x={l-4} y={y(a+i)+4} textAnchor="end" fill="#94a3b8" fontSize="12">{a+i}</text></g>)}
  {WEEKS.map((q,i)=>i%3===0&&<text key={i} x={x(i)} y={H-8} textAnchor="middle" fill="#64748b" fontSize="10">{q.label}</text>)}
  <polyline points={pts(q=>q.target)} fill="none" stroke="#475569" strokeWidth="2" strokeDasharray="6,4"/><polyline points={pts((q,i)=>parseFloat(weeks[i].poids))} fill="none" stroke="#6366f1" strokeWidth="3"/>
  {WEEKS.map((q,i)=>parseFloat(weeks[i].poids)>0&&<circle key={i} cx={x(i)} cy={y(parseFloat(weeks[i].poids))} r="6" fill="#6366f1"/>)}</svg>})()}</div>}
 {tab==="recompenses"&&<div style={{display:"flex",flexDirection:"column",gap:16}}>
  <div style={{background:"linear-gradient(135deg,#0f766e,#0f172a 72%)",borderRadius:16,padding:20,border:"1px solid #134e4a"}}><div style={{fontSize:12,color:"#99f6e4",fontWeight:700}}>🇪🇸 Road to Seville</div><div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-end"}}><div><div style={{fontSize:22,color:"#f8fafc",fontWeight:800}}>Marathon de Séville</div><div style={{fontSize:13,color:"#cbd5e1",marginTop:4}}>{daysLeft} jour{daysLeft>1?"s":""} restant{daysLeft>1?"s":""} · {unl}/{rewards.length} récompenses</div></div><div style={{fontSize:24,fontWeight:800,color:"#5eead4"}}>{Math.round(road*100)}%</div></div><Bar v={road} c="linear-gradient(90deg,#2dd4bf,#f59e0b)"/></div>
  {next&&<div style={card}><div style={{fontSize:12,color:"#f59e0b",fontWeight:700,marginBottom:8}}>🎯 Prochaine récompense</div><div style={{fontSize:17,color:"#f8fafc",fontWeight:800}}>{next.name}</div><div style={{fontSize:12,color:"#94a3b8",marginTop:4}}>{next.cond}</div><div style={{fontSize:12,color:"#fef3c7",marginTop:6}}>🎁 {next.reward}</div><div style={{fontSize:12,color:"#cbd5e1",marginTop:6}}>{next.detail}</div><Bar v={next.progress} c="#f59e0b"/></div>}
  <div style={card}><div style={{fontSize:13,color:"#f8fafc",fontWeight:700,marginBottom:10}}>🏁 Résultat marathon</div><div style={{display:"flex",gap:12,alignItems:"center",flexWrap:"wrap"}}><label style={{color:"#cbd5e1",fontSize:13}}><input type="checkbox" checked={!!mar.finished} onChange={e=>setX("_mar","finished",e.target.checked)}/> Finisher</label><input value={mar.time||""} onChange={e=>setX("_mar","time",e.target.value)} placeholder="03:49:30" style={{...inp,width:110}}/><span style={lab}>HH:MM ou HH:MM:SS</span></div></div>
  <div style={card}><div style={{fontSize:13,color:"#f8fafc",fontWeight:700,marginBottom:10}}>⚖️ Composition corporelle</div><div style={{display:"flex",gap:16,flexWrap:"wrap",color:"#cbd5e1",fontSize:13}}><label><input type="checkbox" checked={!!body.fat} onChange={e=>setX("_body","fat",e.target.checked)}/> Gras &lt; 27 %</label><label><input type="checkbox" checked={!!body.muscle} onChange={e=>setX("_body","muscle",e.target.checked)}/> Muscle &gt; 31 %</label></div></div>
  <div style={{...card,background:secOpen?"#4c1d95":"#111827"}}><div style={{fontSize:12,color:"#94a3b8",fontWeight:800}}>{secOpen?"🎁 Secret débloqué":"🔐 Coffre verrouillé"}</div><div style={{fontSize:15,color:"#f8fafc",marginTop:6}}>{secOpen?SECRET.reward:"Conditions secrètes · révélées au moment opportun"}</div></div>
  {Object.entries(cats).map(([c,rs])=><div key={c}><div style={{fontSize:14,color:"#f8fafc",fontWeight:700,marginBottom:8,display:"flex",justifyContent:"space-between"}}><span>{c}</span><span>{rs.filter(r=>r.unlocked).length}/{rs.length}</span></div>
   <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fit,minmax(230px,1fr))",gap:12}}>{rs.map(r=><div key={r.id} style={{background:r.unlocked?"#064e3b":"#1e293b",border:"1px solid "+(r.unlocked?"#10b981":"#334155"),borderRadius:14,padding:14,opacity:r.unlocked?1:.6,position:"relative"}}><span style={{position:"absolute",top:10,right:12}}>{r.unlocked?"✅":"🔒"}</span><div style={{fontSize:15,fontWeight:700,paddingRight:24}}>{r.name}</div><div style={{fontSize:12,color:"#94a3b8",marginTop:6}}>{r.cond}</div><div style={{fontSize:12,color:"#fef3c7",marginTop:8,fontWeight:600}}>🎁 {r.reward}</div><div style={{fontSize:11,color:"#64748b",marginTop:8}}>{r.detail}</div><Bar v={r.progress} c={r.unlocked?"#10b981":"#64748b"}/></div>)}</div></div>)}</div>}
 {tab==="plan"&&<div style={{display:"flex",flexDirection:"column",gap:10}}>
  <div style={card}><div style={{fontSize:20,color:"#f8fafc",fontWeight:800}}>🏃 Plan running</div><div style={{fontSize:12,color:"#94a3b8",marginTop:4}}>Checklist indépendante de la Saisie · {ctx.plan}/55 cochées</div></div>
  {PLAN.map((wk,wi)=>{const real=wk.filter(s=>!s.e),dn=wk.filter((s,i)=>!s.e&&chk["S"+(wi+1)+"-"+i]).length,full=dn===real.length;return <div key={wi} style={{display:"grid",gridTemplateColumns:"54px 1fr 1fr",gap:6}}>
   <div style={{gridRow:"1 / span 2",background:full?"#064e3b":"#0f172a",border:"1.5px solid "+(full?"#10b981":"#334155"),borderRadius:10,display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",fontWeight:800}}>{full?"✓ ":""}S{wi+1}<span style={{fontSize:10,color:"#94a3b8"}}>{dn}/{real.length}</span></div>
   {wk.map((s,i)=>{const key="S"+(wi+1)+"-"+i,on=!!chk[key];return s.e?<div key={i} style={{border:"1px dashed #334155",borderRadius:10,minHeight:74,display:"flex",alignItems:"center",justifyContent:"center",color:"#334155"}}>/</div>:<button key={i} onClick={()=>setX("_plan",key,!on)} style={{background:on?"#064e3b":"#1e293b",border:"1.5px solid "+(on?"#10b981":"#334155"),borderRadius:10,minHeight:74,padding:8,color:on?"#d1fae5":"#cbd5e1"}}><div style={{fontSize:12,fontWeight:800}}>{on?"✓ ":""}{s.t}</div><div style={{fontSize:11,color:"#94a3b8"}}>{s.t==="EF"?"Footing ":""}{s.d}</div></button>})}</div>})}</div>}
 {toast&&<div style={{position:"fixed",top:18,left:"50%",transform:"translateX(-50%)",background:"linear-gradient(135deg,#064e3b,#0f172a)",border:"1px solid #10b981",borderRadius:16,padding:"14px 18px",zIndex:300,maxWidth:340,width:"calc(100% - 32px)"}}><div style={{fontSize:12,color:"#a7f3d0",fontWeight:800}}>🎉 Récompense débloquée</div><div style={{fontSize:17,fontWeight:800,marginTop:6}}>{toast.name}</div><div style={{fontSize:13,color:"#fef3c7",marginTop:4}}>🎁 {toast.reward}</div></div>}
 </div></div>;
}
ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
</script></body></html>
